# Copie ce fichier en .env.production et remplace <IP_EC2> par l'IP publique de ton instance.
# Ces URLs sont lues au BUILD du frontend (Vite).
VITE_CRAWLER_URL=http://<IP_EC2>:3002
VITE_AUDIT_URL=http://<IP_EC2>:3005
VITE_REPORT_URL=http://<IP_EC2>:3001
VITE_USER_URL=http://<IP_EC2>:8100
VITE_KEYCLOAK_URL=http://<IP_EC2>:8081
